import type { Metadata } from 'next'
import localFont from 'next/font/local'
import './globals.css'

const archivo = localFont({
  src: [
    { path: '../public/fonts/archivo-var.woff2', weight: '100 900', style: 'normal' },
    { path: '../public/fonts/archivo-italic-var.woff2', weight: '100 900', style: 'italic' },
  ],
  variable: '--font-archivo',
  display: 'swap',
})

const archivoExpanded = localFont({
  src: '../public/fonts/archivo-expanded-var.woff2',
  weight: '100 900',
  variable: '--font-archivo-expanded',
  display: 'swap',
})

const jetbrainsMono = localFont({
  src: '../public/fonts/jetbrains-mono-var.woff2',
  weight: '100 800',
  variable: '--font-jetbrains-mono',
  display: 'swap',
})

export const metadata: Metadata = {
  metadataBase: new URL('https://geekstudio.tz'),
  title: {
    default: 'GEEK — Creative technology from East Africa',
    template: '%s · GEEK',
  },
  description:
    'GEEK is a creative-technology company in Dar es Salaam. Studio, Media, Marketing, Growth, Labs.',
  openGraph: { type: 'website', siteName: 'GEEK', locale: 'en_TZ' },
}

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html
      lang="en"
      className={`${archivo.variable} ${archivoExpanded.variable} ${jetbrainsMono.variable}`}
    >
      <body>{children}</body>
    </html>
  )
}